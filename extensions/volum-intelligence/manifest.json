{
  "manifest_version": 3,
  "name": "VOLUM Intelligence",
  "version": "0.3.6",
  "description": "Inteligência comercial Sales Ops, planos SDR e Closer e evidências do RD Station CRM (somente leitura).",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://crm.rdstation.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crm.rdstation.com/app/deals/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Abrir VOLUM Intelligence"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }
}
