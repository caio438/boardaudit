{
  "manifest_version": 3,
  "name": "VOLUM Intelligence",
  "version": "0.3.7",
  "description": "Inteligência comercial Sales Ops, planos SDR e Closer e evidências do RD Station CRM (somente leitura).",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://crm.rdstation.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crm.rdstation.com/app/deals/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/volum-16.png",
    "32": "icons/volum-32.png",
    "48": "icons/volum-48.png",
    "128": "icons/volum-128.png"
  },
  "action": {
    "default_title": "Abrir VOLUM Intelligence",
    "default_icon": {
      "16": "icons/volum-16.png",
      "32": "icons/volum-32.png",
      "48": "icons/volum-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }
}
